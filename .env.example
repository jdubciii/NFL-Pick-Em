# Database Connection String for Prisma and PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nfl_pickem"

# Application Environment
NODE_ENV="development"
PORT=3000
APP_BASE_URL="http://localhost:3000"

# Outbound Mail & Transport Configuration
MAIL_TRANSPORT="console" # console | smtp
MAIL_DOMAIN="localhost"
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nflpickem.local"

# Background Jobs
INTERNAL_JOBS_ENABLED=false
